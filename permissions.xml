<?xml version="1.0" encoding="UTF-8"?>
<quiqqer xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://www.quiqqer.com/docs/schemas/2.x/permissions.xsd">
    <permissions>
        <!-- Produktpfleger: alle Produkte bearbeiten und ausblenden (sonst nur eigene).
             Die App bekommt es in GET /me als permissions.manageProducts -->
        <permission name="piklis.products.manage" type="bool">
            <defaultvalue>0</defaultvalue>
            <rootPermission>1</rootPermission>
            <everyonePermission>0</everyonePermission>
            <guestPermission>0</guestPermission>
        </permission>
    </permissions>
</quiqqer>
